{
  "name": "@component-library/cli",
  "version": "0.0.0",
  "description": "Add Component Library components to your project.",
  "type": "module",
  "bin": {
    "cl": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2"
  }
}
